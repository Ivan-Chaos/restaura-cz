# Where the NestJS API lives. Server-side only: the browser never calls the API
# directly, so this is deliberately not NEXT_PUBLIC_. Must match apps/api's PORT.
API_URL=http://localhost:3001

# Where the landing page's calls to action lead. Both are optional: without
# them the CTAs fall back to a mailto: with a localized subject, so the page
# never has a dead button. `{locale}` and `{plan}` are substituted.
#
#   NEXT_PUBLIC_SIGNUP_URL=https://forms.example/{locale}/start
#   NEXT_PUBLIC_NOTIFY_URL=https://forms.example/{locale}/waitlist?plan={plan}
NEXT_PUBLIC_SIGNUP_URL=
NEXT_PUBLIC_NOTIFY_URL=

# Origin used for metadataBase, and so for absolute Open Graph image URLs.
# Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Optional, development only. When set, `pnpm assets:landing` cross-checks the
# photographer recorded in the manifest against what Pexels reports.
# PEXELS_API_KEY=

# Who is legally responsible for the service. The privacy policy and terms name
# these; until they are set, both pages render a visible "draft, not in force"
# notice rather than quietly claiming to bind someone.
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_ENTITY_ID=
NEXT_PUBLIC_LEGAL_ENTITY_ADDRESS=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
