# Where the NestJS API lives. Server-side only: the browser never calls the API
# directly, so this is deliberately not NEXT_PUBLIC_. Must match apps/api's PORT.
API_URL=http://localhost:3001

# Where the landing page's calls to action lead. Both are optional.
# Unset, "start for free" goes to this app's own /sign-up, and "notify me"
# falls back to a mailto: with a localized subject — the paid tiers have
# nothing to sign up to yet. Set them to send people somewhere else instead.
# `{locale}` and `{plan}` are substituted.
#
#   NEXT_PUBLIC_SIGNUP_URL=https://forms.example/{locale}/start
#   NEXT_PUBLIC_NOTIFY_URL=https://forms.example/{locale}/waitlist?plan={plan}
NEXT_PUBLIC_SIGNUP_URL=
NEXT_PUBLIC_NOTIFY_URL=

# Origin used for metadataBase, and so for absolute Open Graph image URLs.
# Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Optional, development only. When set, `pnpm assets:landing` cross-checks the
# photographer recorded in the manifest against what Pexels reports.
# PEXELS_API_KEY=

# Who is legally responsible for the service. The privacy policy and terms name
# these; until they are set, both pages render a visible "draft, not in force"
# notice rather than quietly claiming to bind someone.
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_ENTITY_ID=
NEXT_PUBLIC_LEGAL_ENTITY_ADDRESS=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=

# Public base URL of uploaded images (feature 006). Must match the API's
# IMAGE_PUBLIC_URL. Read at build time for next/image's remote allowlist, so a
# change needs a rebuild. Defaults to the API's own local-disk route, which is
# what makes uploads work offline.
IMAGE_PUBLIC_URL=http://localhost:3001/dev-images

# --- PDF menu and table stickers (feature 007) -------------------------------
# Documents are produced by a headless Chromium that loads this app's own
# /print routes, so the frontend must run as a long-lived Node server with a
# Chromium available: `pnpm exec playwright install chromium --with-deps` in
# the image, or PDF_CHROMIUM_PATH pointing at a system binary. A serverless
# deployment cannot host this.

# Where the headless browser reaches this server. Defaults to
# http://localhost:${PORT:-3000}. Set it when the app is not on localhost:3000
# from its own point of view (a container port mapping, a socket, a proxy).
# PDF_RENDER_ORIGIN=http://localhost:3000

# Path to a Chromium binary. Unset, playwright-core uses the browser Playwright
# installed for the end-to-end suite, which is what makes local work zero-setup.
# PDF_CHROMIUM_PATH=/usr/bin/chromium

# Set true only where the container forbids Chromium's sandbox. It lowers a
# real security boundary, so it stays off unless the platform demands it.
# PDF_CHROMIUM_NO_SANDBOX=false

# How many documents may render at once. Each costs a browser context and a
# page; the rest queue. Default 2.
# PDF_MAX_CONCURRENT_RENDERS=2
