# Copy to .env for local development. Never commit .env.

# Postgres connection string. Matches docker-compose.yml defaults.
DATABASE_URL=postgres://restaura:restaura@localhost:5433/restaura

# Port the API listens on. The frontend's API_URL must agree with this.
PORT=3001

# Set to true in every deployed environment: it adds the Secure attribute to
# the session cookie, which browsers refuse to send over plain HTTP.
COOKIE_SECURE=false

# Resend API key for confirmation emails. Leave unset locally: without it the
# API logs each 6-digit code to its own console, so the sign-up flow is fully
# testable offline. Required in every deployed environment — an owner who never
# receives a code can never reach the dashboard.
# RESEND_API_KEY=re_...

# From header on every email. Defaults to "Restaura <noreply@restaura.cz>" from
# src/mail/addresses.ts; set this only to send from somewhere else. Whatever it
# is, the domain must be verified in Resend.
# Resend's shared onboarding sender below only delivers to the address that
# owns the Resend account, which makes it usable before restaura.cz is verified.
# EMAIL_FROM=Restaura <onboarding@resend.dev>

# Public origin of the frontend, used for the links inside emails (the welcome
# button, the footer). No trailing slash. Defaults to the local dev server.
APP_URL=http://localhost:3000

# Cloudflare R2, where uploaded logos and dish photos live (feature 006).
# Leave all five unset locally: the API then stores renditions under
# apps/api/.images and serves them itself at /dev-images, so the whole upload
# flow is developable and testable with no credentials and no network. Set all
# five in every deployed environment — half-configured fails at boot.
# The frontend's IMAGE_PUBLIC_URL must match this one: it is read at build time
# for next/image's remote allowlist.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=restaura-images
# IMAGE_PUBLIC_URL=https://img.restaura.cz
