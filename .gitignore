# ===== Monorepo root .gitignore =====
# Layout: apps/frontend (Next.js), apps/backend (NestJS)
# Patterns are unanchored so they apply inside apps/*, and any future package.
# --- Dependencies ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# --- Environment / secrets ---
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12

# --- Next.js (frontend) ---
.next/
out/
next-env.d.ts
.vercel
.turbo/

# --- NestJS (backend) ---
dist/
build/

# --- Tests / coverage ---
coverage/
.nyc_output/
test-results/
playwright-report/

# --- TypeScript ---
*.tsbuildinfo

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*

# --- Caches / tooling ---
.cache/
.eslintcache
.stylelintcache
.parcel-cache/
.swc/

# --- Database / local data ---
*.sqlite
*.sqlite3
*.db
prisma/*.db*

# --- Docker local overrides ---
docker-compose.override.yml

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editors / IDEs ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.swp
*.swo
*~
